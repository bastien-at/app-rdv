{%- set alert = payload.alerts[0] %}
{%- set labels = alert.get("labels", {}) %}
{%- set annotations = alert.get("annotations", {}) %}
{%- set alertname = labels.get("alertname") %}
{%- set rulename = labels.get("rulename", alertname) %}
{%- set group = [] %}
{%- set grouplabels = labels.get("alert_group", "no").split(',') %}
{%- for grouplabel in grouplabels -%}
  {{ group.append(labels.get(grouplabel, "no")) or "" }}
{%- endfor %}
{%- set group = group|join(' - ') %}
{%- set reason = annotations.get("grafana_state_reason", "") %}
{%- set description = annotations.get("description", "seuil franchi") %}
{%- set error = annotations.get("Error", "") %}
{%- if alertname == "DatasourceNoData" or reason == "NoData" %}
  {%- set finalreason = 'Aucune donnée' %}
{%- elif alertname == "DatasourceError" or reason == "Error" %}
  {%- set finalreason = 'Erreur d’exécution de la règle (' + error + ')' %}
{%- elif description != "-" %}
  {%- set finalreason = description %}
  {%- if reason == "MissingSeries" %}
    {%- set finalreason = finalreason + ' (plus de donnée sur la série)' %}
  {%- elif reason == "Updated" %}
    {%- set finalreason = finalreason + ' (règle mise à jour)' %}
  {%- endif %}
{%- elif reason == "Updated" %}
  {%- set finalreason = 'Règle mise à jour' %}
{%- elif reason == "MissingSeries" %}
  {%- set finalreason = 'Plus de donnée sur la série' %}
{%- endif %}

{{- labels.get("grafana_folder") }} - {{ rulename }}
{%- if group and group != "no" %}
 | Cible : {{ group }}
{%- endif %}
{%- if finalreason %}
 | Motif : {{ finalreason }}
{%- endif %}