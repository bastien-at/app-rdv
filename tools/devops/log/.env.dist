ELASTIC_VERSION=9.0.4

## Passwords for stack users
#

# User 'elastic' (built-in)
#
# Superuser role, full access to cluster management and data indices.
# https://www.elastic.co/guide/en/elasticsearch/reference/current/built-in-users.html
ELASTIC_PASSWORD=''
ELASTIC_PASSWORD_SUPERUSER=''

# User 'logstash_internal' (custom)
#
# The user Logstash uses to connect and send data to Elasticsearch.
# https://www.elastic.co/guide/en/logstash/current/ls-security.html
LOGSTASH_INTERNAL_PASSWORD=''

# User 'kibana_system' (built-in)
#
# The user Kibana uses to connect and communicate with Elasticsearch.
# https://www.elastic.co/guide/en/elasticsearch/reference/current/built-in-users.html
KIBANA_SYSTEM_PASSWORD=''

# Users 'metricbeat_internal', 'filebeat_internal' and 'heartbeat_internal' (custom)
#
# The users Beats use to connect and send data to Elasticsearch.
# https://www.elastic.co/guide/en/beats/metricbeat/current/feature-roles.html
METRICBEAT_INTERNAL_PASSWORD=''
FILEBEAT_INTERNAL_PASSWORD=''
HEARTBEAT_INTERNAL_PASSWORD=''

# User 'monitoring_internal' (custom)
#
# The user Metricbeat uses to collect monitoring data from stack components.
# https://www.elastic.co/guide/en/elasticsearch/reference/current/how-monitoring-works.html
MONITORING_INTERNAL_PASSWORD=''

# User 'beats_system' (built-in)
#
# The user the Beats use when storing monitoring information in Elasticsearch.
# https://www.elastic.co/guide/en/elasticsearch/reference/current/built-in-users.html
BEATS_SYSTEM_PASSWORD=''

## Kibana
#
# https://www.elastic.co/guide/en/kibana/current/docker.html#environment-variable-config
KIBANA_DOMAIN=''
KIBANA_BASEPATH=''
KIBANA_HOST=''
KIBANA_ELASTICSEARCH_HOSTS=''
KIBANA_PUBLIC_BASEURL='https://logs.alltricks.sexy:5601'

## Fleet
#
# Namespace Kuvernetes used to deploy Elastic agents.
K8S_NAMESPACE='elastic-agent'
# Fleet url use to interact with Fleet server
FLEET_URL='https://logs.alltricks.sexy:8220'
# Elasticsearch API key used to enroll Elastic Agents in Fleet (https://www.elastic.co/guide/en/fleet/current/fleet-enrollment-tokens.html#fleet-enrollment-tokens)
# If FLEET_ENROLLMENT_TOKEN is empty then KIBANA_HOST, KIBANA_FLEET_USERNAME, KIBANA_FLEET_PASSWORD are needed
FLEET_SERVER_SERVICE_TOKEN=''

AT_STAGING_GKE_FLEET_ENROLLMENT_TOKEN=''
AT_STAGING_KSM_FLEET_ENROLLMENT_TOKEN=''
AT_STAGING_RUM_FLEET_ENROLLMENT_TOKEN=''

AT_PROD_GKE_FLEET_ENROLLMENT_TOKEN=''
AT_PROD_KSM_FLEET_ENROLLMENT_TOKEN=''
AT_PROD_RUM_FLEET_ENROLLMENT_TOKEN=''

TV_STAGING_GKE_FLEET_ENROLLMENT_TOKEN=''
TV_STAGING_KSM_FLEET_ENROLLMENT_TOKEN=''
TV_STAGING_RUM_FLEET_ENROLLMENT_TOKEN=''

TV_PROD_GKE_FLEET_ENROLLMENT_TOKEN=''
TV_PROD_KSM_FLEET_ENROLLMENT_TOKEN=''
TV_PROD_RUM_FLEET_ENROLLMENT_TOKEN=''

## Setup
ELASTICSEARCH_HOST='logs.alltricks.sexy'

## AT PROD
AT_PROD_MYSQL_USER=''
AT_PROD_MYSQL_PASS=''
AT_PROD_MSSQL_USER=''
AT_PROD_MSSQL_PASS=''
